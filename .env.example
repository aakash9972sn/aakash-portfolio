# Copy to .env locally (gitignored); never commit real values.
# Node >=22. Local: npm ci && npm start. Use shell env or --env-file=.env.
PORT=3000
NODE_ENV=development

# Gemini API (server-side secret; never add to browser JS)
GEMINI_API_KEY=
# Gemini models and tiers vary; use models enabled in your Gemini project.
GEMINI_MODEL_FAST=gemini-2.5-flash-lite
GEMINI_MODEL_DEEP=gemini-2.5-pro
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash
GEMINI_MODEL_MAPS=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-live-2.5-flash-preview
ENABLE_LIVE_AUDIO=false
ENABLE_MAPS_GROUNDING=false
# Conservative per-process Gemini requests/minute (host/CDN rate limit still needed)
AI_REQUESTS_PER_MINUTE=12

# Standard PostgreSQL URI for Neon, Supabase, Cloud SQL, local Postgres, etc.
# Leave empty for a no-database deployment: public leaderboard/analytics disabled.
DATABASE_URL=
# Set disable for local non-TLS postgres only.
DATABASE_SSL=require

# Firebase project ID must match firebase-applet-config.json (public frontend config).
FIREBASE_PROJECT_ID=gen-lang-client-0580718541

# Exact allowed browser origins, comma-separated (no paths, no wildcards).
# For GitHub Pages: https://<username>.github.io, not /<repository>
CORS_ORIGIN=https://aakash9972sn.github.io,http://localhost:3000,http://127.0.0.1:3000

# Google Maps server geocoding secret (server-side only, optional).
GOOGLE_MAPS_API_KEY=
# Public Maps JavaScript browser key, restricted in Google Cloud to allowed HTTP referrers.
# Safe to expose to clients ONLY with referrer and API restrictions.
GOOGLE_MAPS_BROWSER_KEY=

# Optional descriptive Nominatim User-Agent on the server; avoid bulk requests.
OSM_USER_AGENT=AakashPortfolio/1.0 (contact: portfolio-maintainer)

# The FRONTEND API_BASE_URL is a public endpoint URL, NOT a secret.
# For GitHub Pages change STATIC_API_ORIGIN in ai-config.js or set
# <meta name="api-base-url" content="https://your-api.example.com">
