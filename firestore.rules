      match /bookmarks/{bookmarkId} {
        allow get: if isValidId(userId) && isValidId(bookmarkId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(bookmarkId)
          && isVerifiedOwner(userId)
          && isValidBookmark(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasOwnerParent(userId);
        allow update: if isValidId(userId)
          && isValidId(bookmarkId)
          && isVerifiedOwner(userId)
          && isValidBookmark(incoming())
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['url', 'title', 'updatedAt'])
          && hasOwnerParent(userId);
        allow delete: if isValidId(userId) && isValidId(bookmarkId) && isVerifiedOwner(userId);
      }

      match /testAttempts/{attemptId} {
        allow get: if isValidId(userId) && isValidId(attemptId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(attemptId)
          && isVerifiedOwner(userId)
          && isValidTestAttempt(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasOwnerParent(userId);
        allow update: if isValidId(userId)
          && isValidId(attemptId)
          && isVerifiedOwner(userId)
          && isValidTestAttempt(incoming())
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['testId', 'title', 'score', 'total', 'at', 'exam', 'subject', 'examId', 'subjectId', 'correct', 'wrong', 'unattempted', 'excluded', 'accuracy', 'topicStats', 'unitStats', 'updatedAt'])
          && hasOwnerParent(userId);
        allow delete: if isValidId(userId) && isValidId(attemptId) && isVerifiedOwner(userId);
      }

      match /orders/{orderId} {
        allow get: if isValidId(userId) && isValidId(orderId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(orderId)
          && isVerifiedOwner(userId)
          && isValidOrderRecord(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasOwnerParent(userId);
        allow update: if isValidId(userId)
          && isValidId(orderId)
          && isVerifiedOwner(userId)
          && isValidOrderRecord(incoming())
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['orderId', 'title', 'status', 'total', 'updatedAt'])
          && hasOwnerParent(userId);
        allow delete: if isValidId(userId) && isValidId(orderId) && isVerifiedOwner(userId);
      }
    }
  }
}
