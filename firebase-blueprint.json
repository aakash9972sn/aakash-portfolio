{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user account profile and optional game high score.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the account owner."
        },
        "displayName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120,
          "description": "Display name from Google sign-in or custom profile setting."
        },
        "photoURL": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000,
          "description": "Google account profile photo URL."
        },
        "photoDataUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 150000,
          "pattern": "^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$",
          "description": "User-uploaded compressed avatar image data URL."
        },
        "bestGuessScore": {
          "type": "integer",
          "description": "Optional lowest guess count recorded in Perfect Guess."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was last updated."
        }
      },
      "required": ["uid", "displayName", "createdAt", "updatedAt"]
    },
    "Bookmark": {
      "title": "Bookmark",
      "description": "A portfolio page bookmarked by the signed-in user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner UID."
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Bookmarked page URL."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Page title."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when bookmark was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when bookmark was updated."
        }
      },
      "required": ["uid", "url", "title", "createdAt", "updatedAt"]
    },
    "TestAttempt": {
      "title": "TestAttempt",
      "description": "A practice test attempt synced from local storage.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner UID."
        },
        "testId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Test identifier."
        },
        "title": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200,
          "description": "Test title."
        },
        "score": {
          "type": "number",
          "description": "Achieved score."
        },
        "total": {
          "type": "number",
          "description": "Maximum possible score."
        },
        "at": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "description": "Attempt timestamp label."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when record was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when record was updated."
        }
      },
      "required": ["uid", "testId", "createdAt", "updatedAt"]
    },
    "OrderRecord": {
      "title": "OrderRecord",
      "description": "A storefront order summary saved to the user's personal history.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner UID."
        },
        "orderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Order identifier."
        },
        "title": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200,
          "description": "Order summary title."
        },
        "status": {
          "type": "string",
          "minLength": 0,
          "maxLength": 50,
          "description": "Order status label."
        },
        "total": {
          "type": "number",
          "description": "Order total amount."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when record was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when record was updated."
        }
      },
      "required": ["uid", "orderId", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile document keyed by Firebase Auth UID."
    },
    "/users/{userId}/bookmarks/{bookmarkId}": {
      "schema": { "$ref": "#/entities/Bookmark" },
      "description": "User's saved portfolio page bookmarks."
    },
    "/users/{userId}/testAttempts/{attemptId}": {
      "schema": { "$ref": "#/entities/TestAttempt" },
      "description": "User's synced test attempt summaries."
    },
    "/users/{userId}/orders/{orderId}": {
      "schema": { "$ref": "#/entities/OrderRecord" },
      "description": "User's synced order history summaries."
    }
  }
}
